<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_VankooPlanDePruebas" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_VankooPlanDePruebas" name="Vankoo · Plan de pruebas del sprint (proceso ideal)" processRef="VankooPlanDePruebas" />
  </bpmn:collaboration>
  <bpmn:process id="VankooPlanDePruebas" name="Plan de pruebas del sprint" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PO" name="Product Owner · Salim">
        <bpmn:flowNodeRef>SprintPlanned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RunAcceptanceTests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IncrementAccepted</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GC" name="Gestor de calidad · Diego">
        <bpmn:flowNodeRef>DefineTestStrategy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PrepareEnvironment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>WriteTestReport</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AC" name="Analista de calidad · Anjali">
        <bpmn:flowNodeRef>RunSystemTests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BlockingDefects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeObservations</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LogDefect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AR" name="Requerimientos · Paúl">
        <bpmn:flowNodeRef>DeriveTestCases</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ForkPreparation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dev" name="Equipo de desarrollo">
        <bpmn:flowNodeRef>DevelopAutomatedTests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JoinPreparation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FixDefect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CI" name="Pipeline CI (automático)">
        <bpmn:flowNodeRef>MergeRegression</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RunAutomatedSuite</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SprintPlanned" name="Sprint planificado">
      <bpmn:outgoing>F1_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="DefineTestStrategy" name="Definir estrategia de pruebas del sprint">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="gestor-calidad" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_01</bpmn:incoming>
      <bpmn:outgoing>F1_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="DeriveTestCases" name="Derivar casos de prueba de los criterios de aceptación">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="adm-requerimientos" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_02</bpmn:incoming>
      <bpmn:outgoing>F1_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ForkPreparation">
      <bpmn:incoming>F1_03</bpmn:incoming>
      <bpmn:outgoing>F1_04</bpmn:outgoing>
      <bpmn:outgoing>F1_05</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="PrepareEnvironment" name="Preparar ambiente y datos de prueba">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="gestor-calidad" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_04</bpmn:incoming>
      <bpmn:outgoing>F1_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="DevelopAutomatedTests" name="Automatizar pruebas junto con la historia">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="desarrollo" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_05</bpmn:incoming>
      <bpmn:outgoing>F1_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="JoinPreparation">
      <bpmn:incoming>F1_06</bpmn:incoming>
      <bpmn:incoming>F1_07</bpmn:incoming>
      <bpmn:outgoing>F1_08</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="MergeRegression">
      <bpmn:incoming>F1_08</bpmn:incoming>
      <bpmn:incoming>F1_16</bpmn:incoming>
      <bpmn:outgoing>F1_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RunAutomatedSuite" name="Ejecutar suite automatizada">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ci-run-test-suite" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_09</bpmn:incoming>
      <bpmn:outgoing>F1_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="RunSystemTests" name="Ejecutar pruebas de sistema y exploratorias">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="analista-calidad" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_10</bpmn:incoming>
      <bpmn:outgoing>F1_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="BlockingDefects" name="¿Defectos críticos o altos?" default="F1_13">
      <bpmn:incoming>F1_11</bpmn:incoming>
      <bpmn:outgoing>F1_12</bpmn:outgoing>
      <bpmn:outgoing>F1_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="MergeObservations">
      <bpmn:incoming>F1_12</bpmn:incoming>
      <bpmn:incoming>F1_20</bpmn:incoming>
      <bpmn:outgoing>F1_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="WriteTestReport" name="Elaborar informe de pruebas">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="gestor-calidad" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_13</bpmn:incoming>
      <bpmn:outgoing>F1_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="LogDefect" name="Registrar y clasificar defecto">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="analista-calidad" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_14</bpmn:incoming>
      <bpmn:outgoing>F1_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="RunAcceptanceTests" name="Ejecutar pruebas de aceptación">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="product-owner" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_17</bpmn:incoming>
      <bpmn:outgoing>F1_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="FixDefect" name="Corregir defecto y añadir prueba de regresión">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="desarrollo" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1_15</bpmn:incoming>
      <bpmn:outgoing>F1_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Accepted" name="¿Conforme?" default="F1_20">
      <bpmn:incoming>F1_18</bpmn:incoming>
      <bpmn:outgoing>F1_19</bpmn:outgoing>
      <bpmn:outgoing>F1_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="IncrementAccepted" name="Incremento aceptado">
      <bpmn:incoming>F1_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1_01" sourceRef="SprintPlanned" targetRef="DefineTestStrategy" />
    <bpmn:sequenceFlow id="F1_02" sourceRef="DefineTestStrategy" targetRef="DeriveTestCases" />
    <bpmn:sequenceFlow id="F1_03" sourceRef="DeriveTestCases" targetRef="ForkPreparation" />
    <bpmn:sequenceFlow id="F1_04" sourceRef="ForkPreparation" targetRef="PrepareEnvironment" />
    <bpmn:sequenceFlow id="F1_05" sourceRef="ForkPreparation" targetRef="DevelopAutomatedTests" />
    <bpmn:sequenceFlow id="F1_06" sourceRef="PrepareEnvironment" targetRef="JoinPreparation" />
    <bpmn:sequenceFlow id="F1_07" sourceRef="DevelopAutomatedTests" targetRef="JoinPreparation" />
    <bpmn:sequenceFlow id="F1_08" sourceRef="JoinPreparation" targetRef="MergeRegression" />
    <bpmn:sequenceFlow id="F1_09" sourceRef="MergeRegression" targetRef="RunAutomatedSuite" />
    <bpmn:sequenceFlow id="F1_10" sourceRef="RunAutomatedSuite" targetRef="RunSystemTests" />
    <bpmn:sequenceFlow id="F1_11" sourceRef="RunSystemTests" targetRef="BlockingDefects" />
    <bpmn:sequenceFlow id="F1_12" name="Sí" sourceRef="BlockingDefects" targetRef="MergeObservations">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=defectosBloqueantes &gt; 0</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1_13" name="No" sourceRef="BlockingDefects" targetRef="WriteTestReport" />
    <bpmn:sequenceFlow id="F1_14" sourceRef="MergeObservations" targetRef="LogDefect" />
    <bpmn:sequenceFlow id="F1_15" sourceRef="LogDefect" targetRef="FixDefect" />
    <bpmn:sequenceFlow id="F1_16" sourceRef="FixDefect" targetRef="MergeRegression" />
    <bpmn:sequenceFlow id="F1_17" sourceRef="WriteTestReport" targetRef="RunAcceptanceTests" />
    <bpmn:sequenceFlow id="F1_18" sourceRef="RunAcceptanceTests" targetRef="Accepted" />
    <bpmn:sequenceFlow id="F1_19" name="Sí" sourceRef="Accepted" targetRef="IncrementAccepted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=conforme = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F1_20" name="No" sourceRef="Accepted" targetRef="MergeObservations" />
  </bpmn:process>
