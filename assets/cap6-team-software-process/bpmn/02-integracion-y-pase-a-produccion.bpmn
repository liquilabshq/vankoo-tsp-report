<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_VankooIntegracionYPase" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_VankooIntegracionYPase" name="Vankoo · Integración y pase a producción (proceso ideal)" processRef="VankooIntegracionYPase" />
  </bpmn:collaboration>
  <bpmn:process id="VankooIntegracionYPase" name="Integración y pase a producción" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PO" name="Product Owner · Salim">
        <bpmn:flowNodeRef>FunctionalSignOff</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GP" name="Planificación · Daniel">
        <bpmn:flowNodeRef>ScheduleRelease</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CloseRelease</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReleaseLive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GC" name="Gestor de calidad · Diego">
        <bpmn:flowNodeRef>ForkConformity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>QualitySignOff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>JoinConformity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AllSignOffs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MonitorPilot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CriticalIncident</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RC" name="Revisor de calidad · Paúl">
        <bpmn:flowNodeRef>ReviewCode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SecuritySignOff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BackToBacklog</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dev" name="Desarrollador (autor)">
        <bpmn:flowNodeRef>StoryDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OpenPullRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FixPullRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeFix</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CI" name="Pipeline CI/CD (automático)">
        <bpmn:flowNodeRef>MergeRetry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BuildAndUnitTest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PipelineGreen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DeployStaging</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RunIntegrationTests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScanVulnerabilities</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DeployProduction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReleaseRolledBack</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StoryDone" name="Historia terminada en su rama">
      <bpmn:outgoing>F2_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="OpenPullRequest" name="Abrir pull request hacia develop">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="desarrollo" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_01</bpmn:incoming>
      <bpmn:outgoing>F2_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="MergeRetry">
      <bpmn:incoming>F2_02</bpmn:incoming>
      <bpmn:incoming>F2_11</bpmn:incoming>
      <bpmn:outgoing>F2_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="BuildAndUnitTest" name="Compilar, analizar y ejecutar pruebas unitarias">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ci-build-unit" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_03</bpmn:incoming>
      <bpmn:outgoing>F2_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PipelineGreen" name="¿Pipeline en verde?" default="F2_06">
      <bpmn:incoming>F2_04</bpmn:incoming>
      <bpmn:outgoing>F2_05</bpmn:outgoing>
      <bpmn:outgoing>F2_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="FixPullRequest" name="Corregir el pull request">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="desarrollo" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_10</bpmn:incoming>
      <bpmn:outgoing>F2_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="MergeFix">
      <bpmn:incoming>F2_06</bpmn:incoming>
      <bpmn:incoming>F2_09</bpmn:incoming>
      <bpmn:outgoing>F2_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="ReviewCode" name="Revisar código (dueño según CODEOWNERS)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="revisor-calidad" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_05</bpmn:incoming>
      <bpmn:outgoing>F2_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ReviewApproved" name="¿Aprobado?" default="F2_09">
      <bpmn:incoming>F2_07</bpmn:incoming>
      <bpmn:outgoing>F2_08</bpmn:outgoing>
      <bpmn:outgoing>F2_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="DeployStaging" name="Fusionar en develop y desplegar en staging">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cd-deploy-staging" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_08</bpmn:incoming>
      <bpmn:outgoing>F2_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="RunIntegrationTests" name="Ejecutar pruebas de integración, contrato y E2E">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ci-integration-e2e" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_12</bpmn:incoming>
      <bpmn:outgoing>F2_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ScanVulnerabilities" name="Analizar vulnerabilidades">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="ci-security-scan" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_13</bpmn:incoming>
      <bpmn:outgoing>F2_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ForkConformity">
      <bpmn:incoming>F2_14</bpmn:incoming>
      <bpmn:outgoing>F2_15</bpmn:outgoing>
      <bpmn:outgoing>F2_16</bpmn:outgoing>
      <bpmn:outgoing>F2_17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="FunctionalSignOff" name="Dar conformidad funcional">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="product-owner" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_15</bpmn:incoming>
      <bpmn:outgoing>F2_18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="QualitySignOff" name="Dar conformidad de pruebas">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="gestor-calidad" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_16</bpmn:incoming>
      <bpmn:outgoing>F2_19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="SecuritySignOff" name="Dar conformidad de seguridad">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="revisor-calidad" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_17</bpmn:incoming>
      <bpmn:outgoing>F2_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="JoinConformity">
      <bpmn:incoming>F2_18</bpmn:incoming>
      <bpmn:incoming>F2_19</bpmn:incoming>
      <bpmn:incoming>F2_20</bpmn:incoming>
      <bpmn:outgoing>F2_21</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="AllSignOffs" name="¿Tres conformidades?" default="F2_23">
      <bpmn:incoming>F2_21</bpmn:incoming>
      <bpmn:outgoing>F2_22</bpmn:outgoing>
      <bpmn:outgoing>F2_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="BackToBacklog" name="Observaciones al backlog">
      <bpmn:incoming>F2_23</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="ScheduleRelease" name="Programar ventana de release">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="gestor-planificacion" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_22</bpmn:incoming>
      <bpmn:outgoing>F2_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="DeployProduction" name="Etiquetar release y desplegar en producción">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cd-deploy-production" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_24</bpmn:incoming>
      <bpmn:outgoing>F2_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="MonitorPilot" name="Supervisar marcha blanca">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="gestor-calidad" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_25</bpmn:incoming>
      <bpmn:outgoing>F2_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="CriticalIncident" name="¿Incidente crítico?" default="F2_28">
      <bpmn:incoming>F2_26</bpmn:incoming>
      <bpmn:outgoing>F2_27</bpmn:outgoing>
      <bpmn:outgoing>F2_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Rollback" name="Revertir a la versión anterior">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="cd-rollback" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_27</bpmn:incoming>
      <bpmn:outgoing>F2_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CloseRelease" name="Cerrar release y registrar postmortem">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="gestor-planificacion" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2_28</bpmn:incoming>
      <bpmn:outgoing>F2_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="ReleaseRolledBack" name="Release revertido">
      <bpmn:incoming>F2_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ReleaseLive" name="Release en producción">
      <bpmn:incoming>F2_30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F2_01" sourceRef="StoryDone" targetRef="OpenPullRequest" />
    <bpmn:sequenceFlow id="F2_02" sourceRef="OpenPullRequest" targetRef="MergeRetry" />
    <bpmn:sequenceFlow id="F2_03" sourceRef="MergeRetry" targetRef="BuildAndUnitTest" />
    <bpmn:sequenceFlow id="F2_04" sourceRef="BuildAndUnitTest" targetRef="PipelineGreen" />
    <bpmn:sequenceFlow id="F2_05" name="Sí" sourceRef="PipelineGreen" targetRef="ReviewCode">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=pipelineVerde = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2_06" name="No" sourceRef="PipelineGreen" targetRef="MergeFix" />
    <bpmn:sequenceFlow id="F2_07" sourceRef="ReviewCode" targetRef="ReviewApproved" />
    <bpmn:sequenceFlow id="F2_08" name="Sí" sourceRef="ReviewApproved" targetRef="DeployStaging">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=aprobado = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2_09" name="No" sourceRef="ReviewApproved" targetRef="MergeFix" />
    <bpmn:sequenceFlow id="F2_10" sourceRef="MergeFix" targetRef="FixPullRequest" />
    <bpmn:sequenceFlow id="F2_11" sourceRef="FixPullRequest" targetRef="MergeRetry" />
    <bpmn:sequenceFlow id="F2_12" sourceRef="DeployStaging" targetRef="RunIntegrationTests" />
    <bpmn:sequenceFlow id="F2_13" sourceRef="RunIntegrationTests" targetRef="ScanVulnerabilities" />
    <bpmn:sequenceFlow id="F2_14" sourceRef="ScanVulnerabilities" targetRef="ForkConformity" />
    <bpmn:sequenceFlow id="F2_15" sourceRef="ForkConformity" targetRef="FunctionalSignOff" />
    <bpmn:sequenceFlow id="F2_16" sourceRef="ForkConformity" targetRef="QualitySignOff" />
    <bpmn:sequenceFlow id="F2_17" sourceRef="ForkConformity" targetRef="SecuritySignOff" />
    <bpmn:sequenceFlow id="F2_18" sourceRef="FunctionalSignOff" targetRef="JoinConformity" />
    <bpmn:sequenceFlow id="F2_19" sourceRef="QualitySignOff" targetRef="JoinConformity" />
    <bpmn:sequenceFlow id="F2_20" sourceRef="SecuritySignOff" targetRef="JoinConformity" />
    <bpmn:sequenceFlow id="F2_21" sourceRef="JoinConformity" targetRef="AllSignOffs" />
    <bpmn:sequenceFlow id="F2_22" name="Sí" sourceRef="AllSignOffs" targetRef="ScheduleRelease">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=conformidadFuncional and conformidadPruebas and conformidadSeguridad</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2_23" name="No" sourceRef="AllSignOffs" targetRef="BackToBacklog" />
    <bpmn:sequenceFlow id="F2_24" sourceRef="ScheduleRelease" targetRef="DeployProduction" />
    <bpmn:sequenceFlow id="F2_25" sourceRef="DeployProduction" targetRef="MonitorPilot" />
    <bpmn:sequenceFlow id="F2_26" sourceRef="MonitorPilot" targetRef="CriticalIncident" />
    <bpmn:sequenceFlow id="F2_27" name="Sí" sourceRef="CriticalIncident" targetRef="Rollback">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=incidenteCritico = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F2_28" name="No" sourceRef="CriticalIncident" targetRef="CloseRelease" />
    <bpmn:sequenceFlow id="F2_29" sourceRef="Rollback" targetRef="ReleaseRolledBack" />
    <bpmn:sequenceFlow id="F2_30" sourceRef="CloseRelease" targetRef="ReleaseLive" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
