        <bpmndi:BPMNLabel>
          <dc:Bounds x="2675" y="609" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ScheduleRelease_di" bpmnElement="ScheduleRelease">
        <dc:Bounds x="2660" y="240" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DeployProduction_di" bpmnElement="DeployProduction">
        <dc:Bounds x="2835" y="840" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MonitorPilot_di" bpmnElement="MonitorPilot">
        <dc:Bounds x="3010" y="390" width="130" height="90" />
      </bpmndi:BPMNShape>
